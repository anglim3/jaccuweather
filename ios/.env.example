# Copy to ios/.env and fill locally. Never commit real values.
# Optional. Empty = Open-Meteo pollen/AQI only (same idea as Worker Previews).

GOOGLE_POLLEN_API_KEY=
TOMORROW_API_KEY=

# NWS requires an identifying User-Agent with contact info.
# Edit the matching line in ios/Jaccuweather/Config/Secrets.xcconfig too
# (that file is what Xcode injects into Info.plist).
NWS_USER_AGENT=JaccuweatherPersonal/1.0 (personal iOS; you@example.com)
